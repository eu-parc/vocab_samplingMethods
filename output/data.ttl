@prefix cenvo: <https://w3id.org/chemical-exposome/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vocab: <https://w3id.org/chemical-exposome/vocabulary/sampling-methods/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/chemical-exposome/vocabulary/sampling-methods> a owl:Ontology ;
    dct:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-6063-0958> ;
    dct:description "Controlled vocabulary of sample collection methods used in environmental monitoring, developed within the PARC project (Partnership for the Assessment of Risks from Chemicals). Covers active and passive air sampling, atmospheric deposition collectors, point (grab) sampling of water, sediment and soil, plant material sampling, and depth-profile sampling. Scope is currently limited to the outdoor (ambient) environment — indoor matrices (indoor air, indoor dust) and biota (e.g. fish, mussels) are not yet covered and may be added in a future version."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-09-07T00:00:00+00:00"^^xsd:dateTime ;
    dct:title "Sampling Methods Vocabulary"@en ;
    owl:versionInfo "0.1.0" .

cenvo:ActiveHiVol a skos:Concept ;
    skos:altLabel "Active - HiVol"@en ;
    skos:definition "Active air sampling using a high-volume sampler. Air is continuously drawn by a pump through a filter and, where applicable, a sorbent medium, on which the target substances are captured. The method uses high air flow rates, typically 200 to 700 L/min (≈ 12 to 42 m³/h), allowing a large volume of air to be processed during the sampling interval and enabling determination of very low analyte concentrations. It is used mainly for monitoring persistent organic pollutants (POPs), PAHs, pesticides, and other trace contaminants in ambient air."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "ActiveHiVol" ;
    skos:prefLabel "ActiveHiVol"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:ActiveLowVol a skos:Concept ;
    skos:altLabel "Active - LowVol"@en ;
    skos:definition "Active air sampling using a low-volume sampler. Air is continuously drawn by a pump through a filter or sorbent medium, on which the target substances are captured. The method uses lower air flow rates, typically 1 to 40 L/min for sorbent-based sampling, or approximately 1 to 3 m³/h (≈ 16 to 50 L/min) for standard PM₁₀ and PM₂.₅ monitoring samplers. The method is suitable for routine long-term air quality monitoring and exposure studies."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "ActiveLowVol" ;
    skos:prefLabel "ActiveLowVol"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:BulkCollector a skos:Concept ;
    skos:altLabel "Bulk collector"@en ;
    skos:definition "Precipitation and dry deposition are collected together in a permanently open collection device. The method provides data on total (wet and dry) atmospheric deposition of the target substances."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "BulkCollector" ;
    skos:prefLabel "BulkCollector"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:FieldSampling a skos:Concept ;
    skos:altLabel "Field sampling"@en ;
    skos:definition "Field collection of plant material. A sample of a plant, or part of a plant, is collected at a defined location and time and represents the state of the plant matrix at the moment of sampling."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "FieldSampling" ;
    skos:prefLabel "FieldSampling"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:Grab a skos:Concept ;
    skos:definition "Point (grab) sampling of water, sediment, or soil. The sample is taken once, from a specific location and time, without combining it with other sub-samples. It represents the condition of the given matrix at the moment of sampling."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "Grab" ;
    skos:prefLabel "Grab"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:GrabFiltration a skos:Concept ;
    skos:altLabel "Grab + Filtration"@en ;
    skos:definition "Point (grab) sampling of water or sediment, followed by filtration. After collection, the sample is filtered to separate the dissolved and solid (particulate) phases for subsequent analysis."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "GrabFiltration" ;
    skos:prefLabel "GrabFiltration"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassiveDGT a skos:Concept ;
    skos:altLabel "Passive DGT"@en ;
    skos:definition "Passive sampling of water, sediment, or soil using DGT (Diffusive Gradients in Thin-films). Target substances diffuse through a hydrogel layer and are accumulated on a binding resin, without the use of a pump. The method is used mainly for trace metals and other inorganic/ionic contaminants; binding gels adapted for other substance groups also exist."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassiveDGT" ;
    skos:prefLabel "PassiveDGT"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassivePOCIS a skos:Concept ;
    skos:altLabel "Passive POCIS"@en ;
    skos:definition "Passive water sampling using a POCIS (Polar Organic Chemical Integrative Sampler). Target substances are continuously accumulated from the aquatic environment onto a sorbent medium enclosed between semipermeable membranes, without the use of a pump. The method is intended mainly for monitoring polar organic contaminants."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassivePOCIS" ;
    skos:prefLabel "PassivePOCIS"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassivePUF a skos:Concept ;
    skos:altLabel "Passive PUF"@en ;
    skos:definition "Passive air sampling without the use of a pump. Target substances are captured on a polyurethane foam (PUF) sorbent medium."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassivePUF" ;
    skos:prefLabel "PassivePUF"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassiveSIP a skos:Concept ;
    skos:altLabel "Passive SIP"@en ;
    skos:definition "Passive air sampling without the use of a pump. Target substances are captured on a sorbent medium consisting of impregnated polyurethane foam (SIP)."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassiveSIP" ;
    skos:prefLabel "PassiveSIP"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassiveSPMD a skos:Concept ;
    skos:altLabel "Passive SPMD"@en ;
    skos:definition "Passive water sampling using a semipermeable membrane device (SPMD). Target substances diffuse from the aquatic environment through a semipermeable membrane into the accumulation medium, without the use of a pump. The method is intended mainly for long-term monitoring of hydrophobic organic contaminants."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassiveSPMD" ;
    skos:prefLabel "PassiveSPMD"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassiveSilicone a skos:Concept ;
    skos:altLabel "Passive SILICONE"@en ;
    skos:definition "Passive water sampling using a silicone sampler. Target substances diffuse from the aquatic environment into the silicone sorbent medium without the use of a pump. The method is suitable mainly for nonpolar and hydrophobic organic contaminants."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassiveSilicone" ;
    skos:prefLabel "PassiveSilicone"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:PassiveXAD a skos:Concept ;
    skos:altLabel "Passive XAD"@en ;
    skos:definition "Passive air sampling without the use of a pump. Target substances are captured on an XAD sorbent resin medium."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "PassiveXAD" ;
    skos:prefLabel "PassiveXAD"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:ProfileSampling a skos:Concept ;
    skos:altLabel "Profile sampling"@en ;
    skos:definition "Depth-profile sampling of soil or sediment. Samples are taken from defined layers or depths and represent the vertical distribution of the target substances within the matrix."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "ProfileSampling" ;
    skos:prefLabel "ProfileSampling"@en ;
    skos:topConceptOf vocab:SamplingMethod .

cenvo:WetOnlyCollector a skos:Concept ;
    skos:altLabel "Wet-only collector"@en ;
    skos:definition "The collection device is automatically opened only during precipitation events, so only precipitation and wet deposition are collected. Dry deposition between precipitation episodes is not sampled."@en ;
    skos:inScheme vocab:SamplingMethod ;
    skos:notation "WetOnlyCollector" ;
    skos:prefLabel "WetOnlyCollector"@en ;
    skos:topConceptOf vocab:SamplingMethod .

vocab:SamplingMethod a skos:ConceptScheme ;
    skos:definition "Methods used to collect environmental samples (air, water, sediment, soil, plant material, atmospheric deposition) prior to laboratory analysis. Covers outdoor (ambient) environmental sampling only; indoor matrices and biota are out of scope for now (see comments above)."@en ;
    skos:hasTopConcept cenvo:ActiveHiVol,
        cenvo:ActiveLowVol,
        cenvo:BulkCollector,
        cenvo:FieldSampling,
        cenvo:Grab,
        cenvo:GrabFiltration,
        cenvo:PassiveDGT,
        cenvo:PassivePOCIS,
        cenvo:PassivePUF,
        cenvo:PassiveSIP,
        cenvo:PassiveSPMD,
        cenvo:PassiveSilicone,
        cenvo:PassiveXAD,
        cenvo:ProfileSampling,
        cenvo:WetOnlyCollector ;
    skos:prefLabel "SamplingMethod"@en .

